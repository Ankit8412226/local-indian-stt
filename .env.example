# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=local_indian_stt

# HuggingFace (only needed for gated models like ai4bharat/indicconformer_*)
# HF_TOKEN=hf_your_token_here
HF_HOME=~/.cache/huggingface

# Application paths
STT_DATA_DIR=./data
STT_OUTPUTS_DIR=./outputs
STT_REPORTS_DIR=./reports
MODEL_CACHE_DIR=./data/cache

# Logging
LOG_LEVEL=INFO
LOG_SENSITIVE=false
